{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "HOCUSPOCUS_PORT",
        "HOCUSPOCUS_JWT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_HOCUSPOCUS_URL",
        "APP_STAGE",
        "BETTER_AUTH_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "EMAIL_FROM",
        "REQUIRE_EMAIL_VERIFICATION",
        "RATE_LIMIT_ENABLED"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "HOCUSPOCUS_PORT",
        "HOCUSPOCUS_JWT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_HOCUSPOCUS_URL",
        "APP_STAGE",
        "BETTER_AUTH_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "EMAIL_FROM",
        "REQUIRE_EMAIL_VERIFICATION",
        "RATE_LIMIT_ENABLED"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "HOCUSPOCUS_PORT",
        "HOCUSPOCUS_JWT_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_HOCUSPOCUS_URL",
        "APP_STAGE",
        "BETTER_AUTH_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "EMAIL_FROM",
        "REQUIRE_EMAIL_VERIFICATION",
        "RATE_LIMIT_ENABLED"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
